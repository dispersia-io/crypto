{
  "name": "@dispersiajs/crypto",
  "version": "1.0.0-canary.0",
  "description": "Isomorphic cryptography layer using Rust WASM",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    "./esm": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./commonjs": {
      "types": "./dist/cjs/index.d.ts",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint:js": "eslint ./translator -c ./eslint.config.mjs",
    "lint:rs": "cargo clippy",
    "lint": "yarn lint:js && yarn lint:rs",
    "lint:fix": "yarn lint:js --fix && yarn format:fix",
    "lint:strict": "yarn lint:js --max-warnings=0 && yarn lint:rs -- -D warnings && yarn format",
    "format": "prettier -c . && cargo fmt --check",
    "format:fix": "prettier -w . && cargo fmt",
    "typecheck": "tsc --noEmit --incremental false",
    "setup": "yarn install && yarn setup:husky",
    "setup:husky": "husky && chmod +x ./.husky/*",
    "clean": "rm -rf dist temp",
    "cleanup": "rm -rf temp",
    "build:wasm:esm": "wasm-pack build --target web --out-dir temp/esm",
    "build:wasm:cjs": "wasm-pack build --target nodejs --out-dir temp/cjs",
    "build:wasm": "npm run build:wasm:esm && npm run build:wasm:cjs",
    "build:ts": "tsc",
    "arrange": "mkdir -p dist/esm dist/cjs && cp temp/esm/wasm* dist/esm/ && cp temp/cjs/wasm* dist/cjs/ && mv dist/esm.mjs dist/esm/index.js && mv dist/esm.d.mts dist/esm/index.d.ts && mv dist/commonjs.cjs dist/cjs/index.js && mv dist/commonjs.d.cts dist/cjs/index.d.ts",
    "build": "npm run clean && npm run build:wasm && npm run build:ts && npm run arrange && npm run cleanup"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/node": "^24.13.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-woofmeow": "^2.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "prettier-plugin-sh": "^0.18.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^20.9.0 || >=21.1.0 <25.0.0"
  },
  "volta": {
    "node": "24.14.1",
    "yarn": "4.13.0"
  }
}
